{
  "name": "relay-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Adapter-driven relay monitoring and alerting platform",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "node node_modules/concurrently/dist/bin/concurrently.js -k -n api,web -c blue,green \"node node_modules/tsx/dist/cli.mjs watch backend/server.ts\" \"node node_modules/vite/bin/vite.js\"",
    "dev:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 -SkipInstall",
    "dev:api": "node node_modules/tsx/dist/cli.mjs watch backend/server.ts",
    "dev:web": "node node_modules/vite/bin/vite.js",
    "build": "pnpm clean && pnpm build:server && pnpm build:web",
    "build:server": "tsc -p tsconfig.backend.json && node -e \"require('node:fs').cpSync('backend/db/migrations','dist/server/backend/db/migrations',{recursive:true})\"",
    "build:web": "vite build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node dist/server/backend/server.js",
    "typecheck": "pnpm typecheck:server && pnpm typecheck:web",
    "typecheck:server": "tsc -p tsconfig.backend.json --noEmit",
    "typecheck:web": "vue-tsc -p tsconfig.frontend.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx backend/cli/migrate.ts",
    "admin:create": "tsx backend/cli/admin.ts create",
    "admin:reset-password": "tsx backend/cli/admin.ts reset-password",
    "master-key:rotate": "tsx backend/cli/master-key.ts rotate",
    "master-key:finalize": "tsx backend/cli/master-key.ts finalize",
    "dev:seed": "tsx backend/cli/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.1",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.0",
    "@fastify/swagger": "^9.8.1",
    "@lucide/vue": "^1.24.0",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.11.1",
    "cron-parser": "5.6.2",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.1.0",
    "fastify": "^5.10.0",
    "fastify-type-provider-zod": "^7.0.0",
    "ipaddr.js": "^2.2.0",
    "liquidjs": "^10.27.2",
    "lossless-json": "^4.3.0",
    "pinia": "^3.0.4",
    "undici": "8.7.0",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.1.4"
  }
}
