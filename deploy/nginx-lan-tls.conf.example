server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name 192.168.1.20;

    ssl_certificate /etc/relay-monitor/tls/relay-monitor.crt;
    ssl_certificate_key /etc/relay-monitor/tls/relay-monitor.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:5173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 10s;
        # Manual probes are synchronous and can include configured retry waits.
        # The maximum accepted policy is just under 11 hours.
        proxy_read_timeout 43200s;
        proxy_send_timeout 300s;
    }
}
