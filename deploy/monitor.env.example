NODE_ENV=production
HOST=0.0.0.0
PORT=5173
TZ=Asia/Shanghai
DATA_DIR=/var/lib/relay-monitor
DATABASE_URL=/var/lib/relay-monitor/monitor.db
MASTER_KEY_FILE=/etc/relay-monitor/master.key
MASTER_KEY_VERSION=1
LOG_LEVEL=info
TRUST_PROXY=false
MANAGED_RESTART=true
SESSION_COOKIE_SECURE=auto
DATABASE_BUSY_TIMEOUT_MS=5000
MAX_CONCURRENT_SITES=5
OUTBOUND_ALLOWED_CIDRS=
# WEB_ORIGIN is optional and only provides an initial address hint before access settings are saved.
