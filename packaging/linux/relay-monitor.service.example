[Unit]
Description=Relay Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=relaymon
Group=relaymon
WorkingDirectory=/opt/relay-monitor/current
Environment=RELAY_MONITOR_ENV_FILE=/etc/relay-monitor/monitor.env
ExecStart=/opt/relay-monitor/current/relay-monitor start
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/relay-monitor
ReadOnlyPaths=/etc/relay-monitor

[Install]
WantedBy=multi-user.target
