# Relay Monitor portable release configuration.
# HOST is a listen address. Open the service with 127.0.0.1 or the server's real LAN address.
NODE_ENV=production
HOST=0.0.0.0
PORT=5173
TZ=Asia/Shanghai
DATA_DIR=./data
DATABASE_URL=./data/monitor.db
MASTER_KEY_FILE=./data/master.key
MASTER_KEY_VERSION=1
LOG_LEVEL=info
TRUST_PROXY=false
MANAGED_RESTART=true
SESSION_COOKIE_SECURE=auto
DATABASE_BUSY_TIMEOUT_MS=5000
MAX_CONCURRENT_SITES=5
OUTBOUND_ALLOWED_CIDRS=
# Optional legacy override. Direct deployments normally leave WEB_ORIGIN unset.
# WEB_ORIGIN=
